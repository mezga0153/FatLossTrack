<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts (long-press the app icon). Actions must match ui/QuickAction.kt -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="snap_meal"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_camera"
        android:shortcutShortLabel="@string/shortcut_snap_meal_short"
        android:shortcutLongLabel="@string/shortcut_snap_meal_long">
        <intent
            android:action="com.fatlosstrack.action.SNAP_MEAL"
            android:targetPackage="com.fatlosstrack"
            android:targetClass="com.fatlosstrack.ui.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="log_meal"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_edit"
        android:shortcutShortLabel="@string/shortcut_log_meal_short"
        android:shortcutLongLabel="@string/shortcut_log_meal_long">
        <intent
            android:action="com.fatlosstrack.action.LOG_MEAL"
            android:targetPackage="com.fatlosstrack"
            android:targetClass="com.fatlosstrack.ui.MainActivity" />
    </shortcut>
</shortcuts>
